# Copy to secrets.env (git-ignored) and fill in your key. Only ANTHROPIC_API_KEY is needed to score jobs.

# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claude model used for scoring, and how long to wait per attempt (each job gets up to 4 attempts).
#CLAUDE_MODEL=claude-opus-5-5
#CLAUDE_TIMEOUT=2m

# More job sources. Each one is skipped while its key is empty.
#ADZUNA_APP_ID=
#ADZUNA_APP_KEY=
#ADZUNA_COUNTRY=us
#JSEARCH_API_KEY=
